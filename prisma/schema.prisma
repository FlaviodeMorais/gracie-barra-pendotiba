generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Banner {
  id          String   @id @default(uuid())
  title       String?
  description String?
  imageUrl    String
  linkUrl     String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id               String              @id @default(uuid())
  title            String
  description      String
  bannerUrl        String?
  date             DateTime
  endDate          DateTime?
  location         String
  address          String?
  status           String              @default("upcoming")
  registrationOpen Boolean             @default(true)
  price            Float               @default(0)
  pixKey           String?
  pixKeyType       String?
  maxParticipants  Int?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  registrations    EventRegistration[]
}

model EventRegistration {
  id            String   @id @default(uuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  email         String
  phone         String
  belt          String   @default("branca")
  academy       String?
  paid          Boolean  @default(false)
  paymentStatus String   @default("pending")
  pixTxId       String?
  notes         String?
  checkedIn     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ClassSchedule {
  id         String   @id @default(uuid())
  day        Int
  startTime  String
  endTime    String
  modality   String
  level      String
  instructor String?
  room       String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TrialClass {
  id            String   @id @default(uuid())
  name          String
  email         String
  phone         String
  preferredDay  String
  preferredTime String
  modality      String   @default("Jiu-Jitsu")
  status        String   @default("pending")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OperatingHours {
  id        String   @id @default(uuid())
  day       Int      @unique
  open      Boolean  @default(true)
  openTime  String   @default("06:00")
  closeTime String   @default("22:00")
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
